OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Cadena de modelos de vision (separados por coma) para OCR de PDF escaneados
# en secciones_tdr.py. Opcional: si no se define, usa el default del codigo.
OPENROUTER_OCR_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free,nvidia/nemotron-nano-12b-v2-vl:free
